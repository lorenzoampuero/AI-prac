---
import '@fontsource-variable/inter';
import { SITE_NAME } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** JSON-LD blocks built via src/seo/schema.ts. Rendered verbatim in <head>. */
  structuredData?: Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData = [] } = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

const origin = Astro.site ?? new URL('https://getaipractice.site');
const canonical = new URL(Astro.url.pathname, origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — practical AI skills, one exercise at a time`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="container" aria-label="Main">
        <a class="brand" href="/">{SITE_NAME}</a>
        <span class="nav-links">
          <a href="/learn">Learn</a>
          <a href="/practice">Practice</a>
          <a href="/assessment">Assessment</a>
          <a href="/glossary">Glossary</a>
          <a href="/about">About</a>
        </span>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Free, no account needed — progress is stored on this device only. · <a href="/privacy">Privacy</a></p>
      </div>
    </footer>
  </body>
</html>
