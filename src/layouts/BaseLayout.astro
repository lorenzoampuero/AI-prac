---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import { getCollection } from 'astro:content';
import { SITE_NAME } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** JSON-LD blocks built via src/seo/schema.ts. Rendered verbatim in <head>. */
  structuredData?: Record<string, unknown>[];
}

const { title, description, noindex = false, structuredData = [] } = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

const origin = Astro.site ?? new URL('https://getaipractice.site');
const canonical = new URL(Astro.url.pathname, origin);

// Vercel Web Analytics — enabled only when the build runs on Vercel (process.env.VERCEL is set there).
// Local and any non-Vercel hosting builds ship zero third-party scripts; see /privacy for the promise.
const showAnalytics = Boolean(process.env.VERCEL);

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const NAV = [
  { href: '/learn', label: 'Learn' },
  { href: '/practice', label: 'Practice' },
  { href: '/assessment', label: 'Assessment' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/about', label: 'About' },
];

// Build-time facts the client scripts need (gamification) — totals, the exercise→track map and titles.
const allLessons = await getCollection('lessons', ({ data }) => !data.draft);
const allExercises = await getCollection('exercises', ({ data }) => !data.draft);
const lessonsTotalPerTrack: Record<string, number> = {};
const exerciseTrack: Record<string, string> = {};
const lessonTitles: Record<string, string> = {};
for (const lesson of allLessons) {
  lessonsTotalPerTrack[lesson.data.track] = (lessonsTotalPerTrack[lesson.data.track] ?? 0) + 1;
  lessonTitles[lesson.id] = lesson.data.title;
  for (const exerciseId of lesson.data.exercises) {
    exerciseTrack[exerciseId] = lesson.data.track;
  }
}
const siteMeta = {
  totalLessons: allLessons.length,
  totalExercises: allExercises.length,
  lessonsTotalPerTrack,
  exerciseTrack,
  lessonTitles,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Resolve the theme before first paint (no flash): a stored choice wins, otherwise follow the system.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var saved = null;
        try {
          saved = localStorage.getItem('aip:theme');
        } catch (err) {
          saved = null;
        }
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var apply = function (theme) {
          root.dataset.theme = theme;
        };
        if (saved === 'light' || saved === 'dark') {
          apply(saved);
        } else {
          apply(mq.matches ? 'dark' : 'light');
          mq.addEventListener('change', function (event) {
            var has = null;
            try {
              has = localStorage.getItem('aip:theme');
            } catch (err) {
              has = null;
            }
            if (!has) apply(event.matches ? 'dark' : 'light');
          });
        }
      })();
    </script>
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110c" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — practical AI skills, one exercise at a time`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {showAnalytics && <Analytics />}
    <ClientRouter />
    <script type="application/json" data-site-meta set:html={JSON.stringify(siteMeta)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" transition:persist="site-header">
      <nav class="container" aria-label="Main">
        <a class="brand" href="/">{SITE_NAME}<span class="brand-dot">.</span></a>
        <span class="nav-side">
          <span class="nav-links">
            {NAV.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </span>
          <a class="level-widget" href="/progress" data-level-widget hidden>
            <span data-lw-name>Lv 1 · Curious</span>
            <span class="lw-xp" data-lw-xp>0 XP</span>
          </a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
            <span class="visually-hidden">Toggle dark mode</span>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
        </span>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p><strong>{SITE_NAME}.</strong></p>
          <p class="footer-tagline">
            Practical AI skills, one exercise at a time. Free, no account — progress is stored on this
            device only.
          </p>
        </div>
        <div>
          <h2>Learn</h2>
          <ul>
            <li><a href="/learn">Curriculum</a></li>
            <li><a href="/practice">Practice</a></li>
            <li><a href="/assessment">Skills check</a></li>
            <li><a href="/glossary">Glossary</a></li>
          </ul>
        </div>
        <div>
          <h2>About</h2>
          <ul>
            <li><a href="/progress">My progress</a></li>
            <li><a href="/about">How it works</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
