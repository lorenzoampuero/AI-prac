---
import { getEntry } from 'astro:content';
import {
  isBuildPrompt,
  isChoiceFamily,
  isEvaluateOutput,
  isFindProblem,
  isFixPrompt,
  isOrderSteps,
  toOptions,
  type BuildPrompt,
  type ChoiceOption,
  type EvaluateOutput,
  type FindProblemClaim,
  type FixPrompt,
} from '../lib/exercise/grade';

interface Props {
  /** Exercise id (file id inside src/content/exercises). */
  id: string;
  /** Standalone pages render their own <h1>; keep an SR-only heading for the section label instead. */
  showHeading?: boolean;
}

const { id, showHeading = true } = Astro.props;
const entry = await getEntry('exercises', id);
const published = Boolean(entry && !entry.data.draft);

let options: ChoiceOption[] | null = null;
let claims: FindProblemClaim[] | null = null;
let fix: FixPrompt | null = null;
let order: string[] | null = null;
let build: BuildPrompt | null = null;
let evaluate: EvaluateOutput | null = null;
let aiResponse = '';
if (entry && published) {
  if (isChoiceFamily(entry.data)) {
    options = toOptions(entry.data);
  } else if (isFindProblem(entry.data)) {
    claims = entry.data.claims;
    aiResponse = entry.data.response;
  } else if (isFixPrompt(entry.data)) {
    fix = entry.data;
  } else if (isOrderSteps(entry.data)) {
    order = entry.data.steps;
  } else if (isBuildPrompt(entry.data)) {
    build = entry.data;
  } else if (isEvaluateOutput(entry.data)) {
    evaluate = entry.data;
  }
}

const config =
  entry && options
    ? JSON.stringify({ id: entry.id, kind: 'choice', options })
    : entry && claims
      ? JSON.stringify({ id: entry.id, kind: 'find-problem', response: aiResponse, claims })
      : entry && fix
        ? JSON.stringify({ id: entry.id, kind: 'fix-prompt' })
        : entry && order
          ? JSON.stringify({ id: entry.id, kind: 'order-steps' })
          : entry && evaluate
            ? JSON.stringify({ id: entry.id, kind: 'evaluate-output', verdict: evaluate.verdict })
            : entry && build
              ? JSON.stringify({ id: entry.id, kind: 'build-prompt', fields: build.fields })
              : '';

// Fixed rotated presentation (never the canonical order) so the answer is not visible before interaction.
let presented: { index: number; text: string }[] = [];
if (order) {
  const offset = Math.floor(order.length / 2);
  const rotated = [...order.slice(offset), ...order.slice(0, offset)];
  presented = rotated.map((text, position) => ({ index: (position + offset) % order.length, text }));
}
---

{
  entry && published && (options || claims || fix || order || build || evaluate) && (
    <section class="exercise" data-exercise data-exercise-id={entry.id} aria-labelledby={`ex-${entry.id}-title`}>
      <h3 id={`ex-${entry.id}-title`} class={showHeading ? undefined : 'visually-hidden'}>
        {entry.data.title}
      </h3>
      <p class="scenario">{entry.data.scenario}</p>
      <p>{entry.data.task}</p>

      {options && (
        <form>
          <fieldset>
            <legend class="meta-line">Choose one option</legend>
            <div class="options">
              {options.map((option) => (
                <label class="option">
                  <input type="radio" name={`choice-${entry.id}`} value={option.id} data-choice-input />
                  <span>
                    <span class="option-label">{option.label}</span>
                    <span>{option.text}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="exercise-actions">
            <button class="button" type="button" data-check>
              Check answer
            </button>
            <span class="xp-note" data-xp hidden />
          </div>
        </form>
      )}

      {claims && (
        <div>
          <p class="example-label">The AI answer</p>
          <blockquote class="ai-response">{aiResponse}</blockquote>
          <form>
            <fieldset>
              <legend class="meta-line">Select every part that should not be trusted as-is</legend>
              <div class="claims">
                {claims.map((claim) => (
                  <label class="claim">
                    <input type="checkbox" value={claim.id} data-claim-input />
                    <span>{claim.text}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="exercise-actions">
              <button class="button" type="button" data-check>
                Check answer
              </button>
              <span class="xp-note" data-xp hidden />
            </div>
          </form>
        </div>
      )}

      {fix && (
        <div>
          <p class="example-label">The weak prompt</p>
          <blockquote class="ai-response">{fix.weakPrompt}</blockquote>
          <form>
            <label class="field-label" for={`fix-input-${entry.id}`}>
              Your improved version
            </label>
            <textarea
              id={`fix-input-${entry.id}`}
              class="prompt-editor"
              rows="5"
              data-fix-input
              placeholder="Write the improved prompt here…"
            />
            <fieldset>
              <legend class="meta-line">Self-check — does your version address these?</legend>
              <div class="claims">
                {fix.criteria.map((criterion) => (
                  <label class="claim">
                    <input type="checkbox" value={criterion.id} data-criterion-input />
                    <span>
                      <strong>{criterion.label}</strong> — {criterion.hint}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="exercise-actions">
              <button class="button" type="button" data-check>
                Compare with a strong version
              </button>
              <span class="xp-note" data-xp hidden />
            </div>
          </form>
          <details data-solution hidden>
            <summary>A strong version (self-assessment — not machine-graded)</summary>
            <p class="solution-text">{fix.sampleSolution}</p>
          </details>
        </div>
      )}

      {order && (
        <div>
          <form>
            <ol class="step-list" data-step-list>
              {presented.map((item) => (
                <li data-step-index={item.index}>
                  <span class="step-text">{item.text}</span>
                  <span class="step-actions">
                    <button type="button" class="step-button" data-move="up" aria-label="Move step up">
                      ↑
                    </button>
                    <button type="button" class="step-button" data-move="down" aria-label="Move step down">
                      ↓
                    </button>
                  </span>
                </li>
              ))}
            </ol>
            <div class="exercise-actions">
              <button class="button" type="button" data-check>
                Check order
              </button>
              <span class="xp-note" data-xp hidden />
            </div>
          </form>
          <details data-solution hidden>
            <summary>Correct order</summary>
            <ol class="step-list step-list-canonical">
              {order.map((step) => (
                <li>
                  <span class="step-text">{step}</span>
                </li>
              ))}
            </ol>
          </details>
        </div>
      )}

      {build && (
        <div>
          <form class="builder">
            {build.fields.map((field) => (
              <div class="field-block">
                <label class="field-label" for={`build-${entry.id}-${field.id}`}>
                  {field.label}
                  {field.required ? '' : ' — optional'}
                </label>
                <textarea
                  id={`build-${entry.id}-${field.id}`}
                  class="prompt-editor"
                  rows="3"
                  data-build-input
                  data-field-id={field.id}
                  placeholder={field.placeholder}
                />
              </div>
            ))}
            <p class="example-label">Your prompt, assembled</p>
            <pre
              class="prompt-preview"
              data-prompt-preview
              data-placeholder="Fill the fields above — this shows exactly what you would paste into the chat."></pre>
            <div class="exercise-actions">
              <button class="button" type="button" data-check>
                Compare with a strong example
              </button>
              <span class="xp-note" data-xp hidden />
            </div>
          </form>
          <details data-solution hidden>
            <summary>A strong example (self-assessment — not machine-graded)</summary>
            <p class="solution-text">{build.sampleSolution}</p>
          </details>
        </div>
      )}

      {evaluate && (
        <div>
          <div class="outputs">
            <div class="output-card">
              <p class="example-label">Output A</p>
              <blockquote class="ai-response">{evaluate.outputA}</blockquote>
            </div>
            <div class="output-card">
              <p class="example-label">Output B</p>
              <blockquote class="ai-response">{evaluate.outputB}</blockquote>
            </div>
          </div>
          <div class="rubric">
            <p class="example-label">Rubric — answer each question for both outputs before deciding</p>
            <ul class="rubric-list">
              {evaluate.rubric.map((item) => (
                <li>{item.label}</li>
              ))}
            </ul>
          </div>
          <form>
            <fieldset>
              <legend class="meta-line">Which output would you ship?</legend>
              <div class="options">
                <label class="option">
                  <input type="radio" name={`verdict-${entry.id}`} value="A" data-evaluate-input />
                  <span>
                    <span class="option-label">Output A</span>
                    <span>This is the one I would ship.</span>
                  </span>
                </label>
                <label class="option">
                  <input type="radio" name={`verdict-${entry.id}`} value="B" data-evaluate-input />
                  <span>
                    <span class="option-label">Output B</span>
                    <span>This is the one I would ship.</span>
                  </span>
                </label>
              </div>
            </fieldset>
            <div class="exercise-actions">
              <button class="button" type="button" data-check>
                Check verdict
              </button>
              <span class="xp-note" data-xp hidden />
            </div>
          </form>
        </div>
      )}

      <div class="feedback" data-feedback role="status" hidden />

      {entry.data.hints.length > 0 && (
        <details>
          <summary>Hint</summary>
          {entry.data.hints.map((hint) => (
            <p>{hint}</p>
          ))}
        </details>
      )}

      <details data-explanation hidden>
        <summary>Why this is the answer</summary>
        <p>{entry.data.explanation}</p>
      </details>

      <script type="application/json" data-exercise-config is:inline set:html={config} />
      <script>
        import { initBuildPromptExercises } from '../scripts/exercise-build-prompt';
        import { initChoiceExercises } from '../scripts/exercise-choice';
        import { initEvaluateOutputExercises } from '../scripts/exercise-evaluate-output';
        import { initFindProblemExercises } from '../scripts/exercise-find-problem';
        import { initFixPromptExercises } from '../scripts/exercise-fix-prompt';
        import { initOrderStepsExercises } from '../scripts/exercise-order-steps';
        initBuildPromptExercises();
        initChoiceExercises();
        initEvaluateOutputExercises();
        initFindProblemExercises();
        initFixPromptExercises();
        initOrderStepsExercises();
      </script>
    </section>
  )
}
