---
// Noise to image, pass by pass: five frames of the same scene with decreasing noise. The scene is a
// simple inline SVG (no image assets); feTurbulence supplies the noise. Without JavaScript every
// frame renders in its refined state; the script staggers the reveal and offers a replay.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
const DEFAULT_CAPTION =
  'The same process drawn out: each pass nudges random noise toward the prompt. There is no draft hidden underneath — every pass refines what the last one produced.';
const baseFrequency = [0.9, 0.68, 0.46, 0.26, 0.08];
const noiseOpacity = [1, 0.72, 0.46, 0.22, 0];
---
<section class="ds-strip" data-ds-strip aria-label="From noise to image, pass by pass">
  <ol class="ds-frames">
    {baseFrequency.map((frequency, index) => (
      <li class="ds-frame" data-ds-frame style={`--i:${index}`}>
        <svg
          viewBox="0 0 120 90"
          role="img"
          aria-label={index === 0
            ? 'First pass: pure noise'
            : index === baseFrequency.length - 1
              ? 'Final pass: the finished image'
              : `Pass ${index + 1}: partly refined noise`}
        >
          <defs>
            <filter id={`ds-noise-${uid}-${index}`} x="0" y="0" width="100%" height="100%">
              <feTurbulence
                type="fractalNoise"
                baseFrequency={String(frequency)}
                numOctaves="3"
                seed="7"
                stitchTiles="stitch"
              />
            </filter>
          </defs>
          <rect class="ds-sky" width="120" height="90" />
          <circle class="ds-sun" cx="86" cy="28" r="11" />
          <polygon class="ds-mountain" points="0,90 34,40 64,90" />
          <polygon class="ds-mountain ds-mountain-2" points="36,90 80,50 120,90" />
          <rect class="ds-ground" y="78" width="120" height="12" />
          <rect width="120" height="90" filter={`url(#ds-noise-${uid}-${index})`} opacity={String(noiseOpacity[index])} />
        </svg>
        <span class="ds-label">
          {index === 0 ? 'noise' : index === baseFrequency.length - 1 ? 'your image' : `pass ${index + 1}`}
        </span>
      </li>
    ))}
  </ol>
  <p class="ds-caption">{caption ?? DEFAULT_CAPTION}</p>
  <div class="visual-controls">
    <button class="button secondary" type="button" data-ds-replay>Replay the passes</button>
  </div>
  <script>
    import '../../scripts/visuals';
  </script>
</section>
