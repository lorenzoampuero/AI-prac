---
// Weak vs stronger prompt, side by side. Fully readable without JavaScript.
import { localeOf, uiStrings } from '../../i18n/ui';

interface Props {
  weak: string;
  strong: string;
  weakLabel?: string;
  strongLabel?: string;
  notes?: string[];
}
const { weak, strong, weakLabel, strongLabel, notes = [] } = Astro.props;
const s = uiStrings(localeOf(Astro.currentLocale)).promptCompare;
---

<section class="prompt-compare" aria-label={s.aria}>
  <div class="pc-pane pc-weak">
    <p class="pc-label">{weakLabel ?? s.weakLabel}</p>
    <p class="pc-text">{weak}</p>
  </div>
  <div class="pc-pane pc-strong">
    <p class="pc-label">{strongLabel ?? s.strongLabel}</p>
    <p class="pc-text">{strong}</p>
  </div>
  {
    notes.length > 0 && (
      <details class="pc-notes">
        <summary>{s.whyStronger}</summary>
        <ul>
          {notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </details>
    )
  }
</section>
