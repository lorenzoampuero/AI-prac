---
// End-of-lesson summary card. Bullets animate in as the card scrolls into view.
interface Props {
  items: string[];
  title?: string;
}
const { items, title = 'Key takeaways' } = Astro.props;
---

<section class="takeaways reveal" aria-label={title}>
  <p class="takeaways-title">{title}</p>
  <ul>
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>
