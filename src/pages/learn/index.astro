---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TRACKS } from '../../data/tracks';
import { breadcrumbJsonLd } from '../../seo/schema';

const origin = Astro.site ?? new URL('https://getaipractice.site');

const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const lesson of lessons) {
  counts.set(lesson.data.track, (counts.get(lesson.data.track) ?? 0) + 1);
}
---

<BaseLayout
  title="Learn AI: A Free, Practice-First Curriculum"
  description="Learn AI with short lessons across eight tracks — foundations, prompting, verification, work and more. Every lesson ends in a hands-on exercise. Free, no account."
  structuredData={[
    breadcrumbJsonLd(
      [
        { name: 'Home', path: '/' },
        { name: 'Learn', path: '/learn' },
      ],
      origin,
    ),
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-current="page">Learn</li>
    </ol>
  </nav>

  <h1>Learn practical AI skills</h1>
  <p class="lede">
    Tracks run from “what is generative AI” to designing reliable workflows. Every lesson ends in
    practice — not a quiz about definitions.
  </p>

  <div class="grid" style="margin-top: var(--space-5);">
    {
      TRACKS.map((track) => {
        const count = counts.get(track.id) ?? 0;
        return (
          <div class="card">
            <h3>{track.name}</h3>
            <p class="meta-line">{track.tagline}</p>
            {count > 0 ? (
              <a href={`/learn/${track.id}`}>
                {count} lesson{count === 1 ? '' : 's'}
              </a>
            ) : (
              <p class="meta-line">Lessons arrive in a later wave.</p>
            )}
          </div>
        );
      })
    }
  </div>

  <p class="meta-line" style="margin-top: var(--space-5);">
    Looking for an answer to a specific question — verifying AI output, privacy, agents, cover
    letters? The <a href="/faq">questions page</a> answers them in plain language and links the lesson
    that teaches each one.
  </p>
</BaseLayout>
