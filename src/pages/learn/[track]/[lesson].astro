---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTrack } from '../../../data/tracks';
import { breadcrumbJsonLd, learningResourceJsonLd } from '../../../seo/schema';

interface NavLesson {
  id: string;
  href: string;
  title: string;
}

export async function getStaticPaths() {
  // NOTE: getStaticPaths is extracted into its own chunk during build — it must be self-contained
  // (imports only; no references to module-level constants).
  const toNav = (entry: CollectionEntry<'lessons'>): NavLesson => ({
    id: entry.id,
    title: entry.data.title,
    href: `/learn/${entry.data.track}/${entry.id.split('/').slice(1).join('/')}`,
  });

  const lessons = await getCollection('lessons', ({ data }) => !data.draft);

  const byTrack = new Map<string, CollectionEntry<'lessons'>[]>();
  for (const lesson of lessons) {
    const list = byTrack.get(lesson.data.track) ?? [];
    list.push(lesson);
    byTrack.set(lesson.data.track, list);
  }

  const paths: {
    params: { track: string; lesson: string };
    props: { entry: CollectionEntry<'lessons'>; prev: NavLesson | null; next: NavLesson | null };
  }[] = [];

  for (const [track, list] of byTrack) {
    const sorted = [...list].sort((a, b) => a.data.order - b.data.order);
    sorted.forEach((entry, index) => {
      const prevEntry = index > 0 ? sorted[index - 1] : undefined;
      const nextEntry = index < sorted.length - 1 ? sorted[index + 1] : undefined;
      paths.push({
        params: { track, lesson: entry.id.split('/').slice(1).join('/') },
        props: {
          entry,
          prev: prevEntry ? toNav(prevEntry) : null,
          next: nextEntry ? toNav(nextEntry) : null,
        },
      });
    });
  }

  return paths;
}

type Props = { entry: CollectionEntry<'lessons'>; prev: NavLesson | null; next: NavLesson | null };
const { entry, prev, next } = Astro.props as Props;

const { Content } = await render(entry);
const trackInfo = getTrack(entry.data.track);

const origin = Astro.site ?? new URL('https://getaipractice.site');
const lessonPath = `/learn/${entry.data.track}/${entry.id.split('/').slice(1).join('/')}`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Learn', path: '/learn' },
  { name: trackInfo?.name ?? entry.data.track, path: `/learn/${entry.data.track}` },
  { name: entry.data.title, path: lessonPath },
];
const structuredData = [
  breadcrumbJsonLd(breadcrumbs, origin),
  learningResourceJsonLd(
    {
      name: entry.data.title,
      description: entry.data.description,
      path: lessonPath,
      minutes: entry.data.estimatedMinutes,
    },
    origin,
  ),
];

const LEVEL_LABELS: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
};
const levelLabel = LEVEL_LABELS[entry.data.level] ?? entry.data.level;
---

<BaseLayout title={entry.data.title} description={entry.data.description} structuredData={structuredData}>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/learn">Learn</a></li>
      <li><a href={`/learn/${entry.data.track}`}>{trackInfo?.name ?? entry.data.track}</a></li>
      <li aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <article class="prose" data-lesson-page data-lesson-id={entry.id}>
    <header>
      <h1>{entry.data.title}</h1>
      <p class="meta-line">
        {levelLabel} · {entry.data.estimatedMinutes} min · {entry.data.learningOutcome}
      </p>
      {entry.data.class === 'current' && entry.data.lastReviewed && (
        <p class="meta-line">Product-specific details last reviewed: {entry.data.lastReviewed.toISOString().slice(0, 10)}</p>
      )}
      <ul class="chips">
        {entry.data.skills.map((skill) => <li class="chip">{skill}</li>)}
      </ul>
    </header>

    <Content />
  </article>

  <section class="lesson-finish" data-lesson-complete aria-label="Lesson completion">
    <div>
      <p class="lf-title">Finished this lesson?</p>
      <p class="lf-note" data-lesson-done hidden>Learned — this one is on your record.</p>
    </div>
    <div class="lf-actions">
      <button class="button" type="button" data-lesson-complete-btn>Mark as learned · +10 XP</button>
      <button class="button secondary" type="button" data-bookmark-btn aria-pressed="false">Save for later</button>
    </div>
  </section>

  <nav aria-label="Lesson navigation" class="meta-line lesson-nav">
    {prev && <p>Previous: <a href={prev.href}>{prev.title}</a></p>}
    {next && <p>Next: <a href={next.href}>{next.title}</a></p>}
  </nav>

  <script>
    import '../../../scripts/lesson';
  </script>
</BaseLayout>
