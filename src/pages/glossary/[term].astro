---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, definedTermJsonLd } from '../../seo/schema';

interface RelatedLesson {
  title: string;
  href: string;
}

export async function getStaticPaths() {
  const terms = await getCollection('glossary', ({ data }) => !data.draft);
  const lessons = await getCollection('lessons', ({ data }) => !data.draft);
  const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));

  return terms.map((entry) => ({
    params: { term: entry.id },
    props: {
      entry,
      relatedLessons: entry.data.relatedLessons
        .map((ref) => lessonById.get(ref))
        .filter((lesson): lesson is CollectionEntry<'lessons'> => Boolean(lesson))
        .map(
          (lesson): RelatedLesson => ({
            title: lesson.data.title,
            href: `/learn/${lesson.data.track}/${lesson.id.split('/').slice(1).join('/')}`,
          }),
        ),
    },
  }));
}

type Props = { entry: CollectionEntry<'glossary'>; relatedLessons: RelatedLesson[] };
const { entry, relatedLessons } = Astro.props as Props;

const origin = Astro.site ?? new URL('https://ai-practice.invalid');
const termPath = `/glossary/${entry.id}`;
---

<BaseLayout
  title={`${entry.data.term} — definition`}
  description={entry.data.definition.slice(0, 160)}
  structuredData={[
    breadcrumbJsonLd(
      [
        { name: 'Home', path: '/' },
        { name: 'Glossary', path: '/glossary' },
        { name: entry.data.term, path: termPath },
      ],
      origin,
    ),
    definedTermJsonLd(
      { term: entry.data.term, definition: entry.data.definition, path: termPath, setPath: '/glossary' },
      origin,
    ),
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/glossary">Glossary</a></li>
      <li aria-current="page">{entry.data.term}</li>
    </ol>
  </nav>

  <h1>{entry.data.term}</h1>
  <p>{entry.data.definition}</p>

  {
    relatedLessons.length > 0 && (
      <section aria-labelledby="learn-it-in">
        <h2 id="learn-it-in">Learn it in</h2>
        <ul class="lesson-list">
          {relatedLessons.map((lesson) => (
            <li>
              <a href={lesson.href}>{lesson.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p>
    <a href="/glossary">← All terms</a>
  </p>
</BaseLayout>
