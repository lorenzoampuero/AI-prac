---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, definedTermJsonLd } from '../../seo/schema';
import { clipAtSentence } from '../../lib/seo-text';
import { SITE_ORIGIN } from '../../config/site';

interface RelatedLink {
  title: string;
  href: string;
}

export async function getStaticPaths() {
  const terms = await getCollection('glossary', ({ data }) => !data.draft);
  const lessons = await getCollection('lessons', ({ data }) => !data.draft);
  const exercises = await getCollection('exercises', ({ data }) => !data.draft);
  const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
  const exerciseById = new Map(exercises.map((exercise) => [exercise.id, exercise]));

  return terms.map((entry) => ({
    params: { term: entry.id },
    props: {
      entry,
      relatedLessons: entry.data.relatedLessons
        .map((ref) => lessonById.get(ref))
        .filter((lesson): lesson is CollectionEntry<'lessons'> => Boolean(lesson))
        .map(
          (lesson): RelatedLink => ({
            title: lesson.data.title,
            href: `/learn/${lesson.data.track}/${lesson.id.split('/').slice(1).join('/')}`,
          }),
        ),
      relatedExercises: entry.data.relatedExercises
        .map((ref) => exerciseById.get(ref))
        .filter((exercise): exercise is CollectionEntry<'exercises'> => Boolean(exercise))
        .map((exercise): RelatedLink => ({ title: exercise.data.title, href: `/practice/${exercise.id}` })),
    },
  }));
}

type Props = {
  entry: CollectionEntry<'glossary'>;
  relatedLessons: RelatedLink[];
  relatedExercises: RelatedLink[];
};
const { entry, relatedLessons, relatedExercises } = Astro.props as Props;

const origin = Astro.site ?? new URL(SITE_ORIGIN);
const termPath = `/glossary/${entry.id}`;
// "What is X?" — lowercase the first letter unless the term starts with an acronym (RAG, LLM…).
const termLower = /^[A-Z]{2,}/.test(entry.data.term)
  ? entry.data.term
  : entry.data.term.charAt(0).toLowerCase() + entry.data.term.slice(1);
---

<BaseLayout
  title={`What is ${termLower}?`}
  description={clipAtSentence(entry.data.definition, 155)}
  structuredData={[
    breadcrumbJsonLd(
      [
        { name: 'Home', path: '/' },
        { name: 'Glossary', path: '/glossary' },
        { name: entry.data.term, path: termPath },
      ],
      origin,
    ),
    definedTermJsonLd(
      { term: entry.data.term, definition: entry.data.definition, path: termPath, setPath: '/glossary' },
      origin,
    ),
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/glossary">Glossary</a></li>
      <li aria-current="page">{entry.data.term}</li>
    </ol>
  </nav>

  <h1>{entry.data.term}</h1>
  <p>{entry.data.definition}</p>

  {
    relatedLessons.length > 0 && (
      <section aria-labelledby="learn-it-in">
        <h2 id="learn-it-in">Learn it in</h2>
        <ul class="lesson-list">
          {relatedLessons.map((lesson) => (
            <li>
              <a href={lesson.href}>{lesson.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedExercises.length > 0 && (
      <section aria-labelledby="practice-it">
        <h2 id="practice-it">Practice it</h2>
        <ul class="lesson-list">
          {relatedExercises.map((exercise) => (
            <li>
              <a href={exercise.href}>{exercise.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p>
    <a href="/glossary">← All terms</a>
  </p>
</BaseLayout>
