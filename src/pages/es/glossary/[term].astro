---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, definedTermJsonLd } from '../../../seo/schema';
import { clipAtSentence } from '../../../lib/seo-text';

interface RelatedLink {
  title: string;
  href: string;
}

export async function getStaticPaths() {
  const terms = await getCollection('glossaryEs', ({ data }) => !data.draft);
  const lessons = await getCollection('lessonsEs', ({ data }) => !data.draft);
  const exercises = await getCollection('exercisesEs', ({ data }) => !data.draft);
  const lessonById = new Map(lessons.map((lesson) => [lesson.id, lesson]));
  const exerciseById = new Map(exercises.map((exercise) => [exercise.id, exercise]));

  return terms.map((entry) => ({
    params: { term: entry.id },
    props: {
      entry,
      relatedLessons: entry.data.relatedLessons
        .map((ref) => lessonById.get(ref))
        .filter((lesson): lesson is CollectionEntry<'lessonsEs'> => Boolean(lesson))
        .map(
          (lesson): RelatedLink => ({
            title: lesson.data.title,
            href: `/es/learn/${lesson.data.track}/${lesson.id.split('/').slice(1).join('/')}`,
          }),
        ),
      relatedExercises: entry.data.relatedExercises
        .map((ref) => exerciseById.get(ref))
        .filter((exercise): exercise is CollectionEntry<'exercisesEs'> => Boolean(exercise))
        .map((exercise): RelatedLink => ({ title: exercise.data.title, href: `/es/practice/${exercise.id}` })),
    },
  }));
}

type Props = {
  entry: CollectionEntry<'glossaryEs'>;
  relatedLessons: RelatedLink[];
  relatedExercises: RelatedLink[];
};
const { entry, relatedLessons, relatedExercises } = Astro.props as Props;

const origin = Astro.site ?? new URL('https://getaipractice.site');
const termPath = `/es/glossary/${entry.id}`;
// "¿Qué es X?" — lowercase the first letter unless the term starts with an acronym (RAG, LLM…).
const termLower = /^[A-Z]{2,}/.test(entry.data.term)
  ? entry.data.term
  : entry.data.term.charAt(0).toLowerCase() + entry.data.term.slice(1);
---

<BaseLayout
  locale="es"
  title={`¿Qué es ${termLower}?`}
  description={clipAtSentence(entry.data.definition, 155)}
  structuredData={[
    breadcrumbJsonLd(
      [
        { name: 'Inicio', path: '/es' },
        { name: 'Glosario', path: '/es/glossary' },
        { name: entry.data.term, path: termPath },
      ],
      origin,
    ),
    definedTermJsonLd(
      { term: entry.data.term, definition: entry.data.definition, path: termPath, setPath: '/es/glossary' },
      origin,
    ),
  ]}
>
  <nav class="breadcrumbs" aria-label="Ruta de navegación">
    <ol>
      <li><a href="/es">Inicio</a></li>
      <li><a href="/es/glossary">Glosario</a></li>
      <li aria-current="page">{entry.data.term}</li>
    </ol>
  </nav>

  <h1>{entry.data.term}</h1>
  <p>{entry.data.definition}</p>

  {
    relatedLessons.length > 0 && (
      <section aria-labelledby="learn-it-in">
        <h2 id="learn-it-in">Apréndelo en</h2>
        <ul class="lesson-list">
          {relatedLessons.map((lesson) => (
            <li>
              <a href={lesson.href}>{lesson.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedExercises.length > 0 && (
      <section aria-labelledby="practice-it">
        <h2 id="practice-it">Practícalo</h2>
        <ul class="lesson-list">
          {relatedExercises.map((exercise) => (
            <li>
              <a href={exercise.href}>{exercise.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p>
    <a href="/es/glossary">← Todos los términos</a>
  </p>
</BaseLayout>
