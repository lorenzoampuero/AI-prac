---
import { getCollection, type CollectionEntry } from 'astro:content';
import PromptSetView from '../../../components/prompts/PromptSetView.astro';

export async function getStaticPaths() {
  const sets = await getCollection('promptsEs', ({ data }) => !data.draft);
  return sets.map((set) => ({ params: { set: set.id }, props: { set } }));
}

const { set } = Astro.props as { set: CollectionEntry<'promptsEs'> };
---

<PromptSetView locale="es" set={set} />
