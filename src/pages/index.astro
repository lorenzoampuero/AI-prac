---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NextTokenDemo from '../components/lesson/NextTokenDemo.astro';
import { TRACKS } from '../data/tracks';
import { SITE_NAME, SITE_ORIGIN } from '../config/site';
import { organizationJsonLd, websiteJsonLd } from '../seo/schema';

const origin = Astro.site ?? new URL(SITE_ORIGIN);
const description =
  'Learn AI skills with short, free lessons and hands-on exercises — prompting, verification, research and work. No account; progress stays on your device.';

const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const exercises = await getCollection('exercises', ({ data }) => !data.draft);
const terms = await getCollection('glossary', ({ data }) => !data.draft);
const trackPriority = new Map(TRACKS.map((track, index) => [track.id, index]));

const counts = new Map<string, number>();
for (const lesson of lessons) {
  counts.set(lesson.data.track, (counts.get(lesson.data.track) ?? 0) + 1);
}

const firstLesson = [...lessons].sort((a, b) => {
  const trackDiff = (trackPriority.get(a.data.track) ?? 99) - (trackPriority.get(b.data.track) ?? 99);
  return trackDiff !== 0 ? trackDiff : a.data.order - b.data.order;
})[0];

const firstLessonHref = firstLesson
  ? `/learn/${firstLesson.data.track}/${firstLesson.id.split('/').slice(1).join('/')}`
  : '/learn';
---

<BaseLayout
  title="AI Practice — Learn AI Skills With Hands-On Exercises"
  suffix={false}
  description={description}
  structuredData={[
    websiteJsonLd({ name: SITE_NAME, description, path: '/' }, origin),
    organizationJsonLd(
      {
        name: SITE_NAME,
        description: 'A free, practice-first way to learn practical AI skills.',
        logoPath: '/og.png',
      },
      origin,
    ),
  ]}
>
  <section class="hero hero-enter">
    <p class="eyebrow">Practical AI literacy</p>
    <h1>Build real AI skills, <em>one exercise</em> at a time.</h1>
    <p class="lede">
      Short lessons and hands-on practice that teach you to prompt, verify, research and work with AI.
      No signup, no API keys — and your progress stays on your device.
    </p>
    <div class="cta-row">
      <a class="button" href={firstLessonHref}>Start the first lesson</a>
      <a class="button secondary" href="/learn">Browse the curriculum</a>
      <a class="button secondary" href="/assessment">Take the skills check</a>
    </div>
    <ul class="stats-row">
      <li><span class="stat-value">{lessons.length}</span><span class="stat-label">lessons</span></li>
      <li><span class="stat-value">{exercises.length}</span><span class="stat-label">exercises</span></li>
      <li><span class="stat-value">{terms.length}</span><span class="stat-label">glossary terms</span></li>
      <li><span class="stat-value">$0</span><span class="stat-label">free, no account</span></li>
    </ul>
  </section>

  <section class="continue-strip" data-continue hidden aria-label="Continue learning">
    <div>
      <p class="cs-label">Continue learning</p>
      <p class="cs-title" data-continue-title>Pick up where you left off</p>
    </div>
    <a class="button" href="/learn" data-continue-link>Resume</a>
  </section>

  <section class="demo-band" aria-labelledby="demo-title">
    <div class="demo-copy">
      <p class="eyebrow">Try it before you read a thing</p>
      <h2 id="demo-title" class="section-title">Watch the model predict the next word</h2>
      <p class="meta-line">
        This is the real diagram from the first track: AI writes by scoring every plausible
        continuation and sampling one. That single step explains hallucinations, why answers vary,
        and why verification is a skill — not a trick. Sample it yourself.
      </p>
      <a class="button secondary" href="/learn/ai-foundations/what-an-llm-actually-does">
        Open the lesson this comes from
      </a>
    </div>
    <div class="demo-widget">
      <NextTokenDemo
        prompt="The cat sat on the"
        options={[
          { token: 'mat', pct: 41 },
          { token: 'floor', pct: 24 },
          { token: 'windowsill', pct: 15 },
          { token: 'sofa', pct: 11 },
          { token: 'everything else', pct: 9 },
        ]}
      />
    </div>
  </section>

  <section aria-labelledby="tracks-title">
    <h2 id="tracks-title" class="section-title">Tracks</h2>
    <div class="grid">
      {
        TRACKS.map((track) => {
          const count = counts.get(track.id) ?? 0;
          const style = `--track-color: var(--track-${track.id})`;
          const inner = (
            <>
              <h3>
                <span class="track-dot" aria-hidden="true" />
                {track.name}
              </h3>
              <p class="meta-line">{track.tagline}</p>
              {count > 0 ? (
                <span class="track-count">
                  {count} lesson{count === 1 ? '' : 's'} — start the track →
                </span>
              ) : (
                <span class="track-count is-future">Lessons arrive in a later wave.</span>
              )}
            </>
          );
          return count > 0 ? (
            <a class="card card--lift track-card reveal" style={style} href={`/learn/${track.id}`}>
              {inner}
            </a>
          ) : (
            <div class="card track-card reveal" style={style}>
              {inner}
            </div>
          );
        })
      }
    </div>
  </section>

  <section aria-labelledby="how-title">
    <h2 id="how-title" class="section-title">How it works</h2>
    <ol class="how-grid">
      <li class="card reveal">
        <p><strong>Read the concept.</strong></p>
        <p class="meta-line">Two minutes of plain language — with a weak and a stronger example side by side.</p>
      </li>
      <li class="card reveal" style="--reveal-delay:80ms">
        <p><strong>Practice immediately.</strong></p>
        <p class="meta-line">Every lesson ends in a real exercise; feedback explains why, never just “wrong”.</p>
      </li>
      <li class="card reveal" style="--reveal-delay:160ms">
        <p><strong>Transfer it anywhere.</strong></p>
        <p class="meta-line">Skills that work in any AI tool — principles, not one magic prompt.</p>
      </li>
    </ol>
  </section>

  <section class="trust-band" aria-labelledby="trust-title">
    <h2 id="trust-title" class="section-title">Why you can trust this practice</h2>
    <ul class="trust-grid">
      <li class="card reveal">
        <p><strong>{lessons.length} lessons, {exercises.length} exercises.</strong></p>
        <p class="meta-line">
          Every lesson ends in a real task with feedback that explains why — not a quiz about
          definitions.
        </p>
      </li>
      <li class="card reveal" style="--reveal-delay:80ms">
        <p><strong>Sourced, dated, checked.</strong></p>
        <p class="meta-line">
          Product-specific claims carry a source and a review date, and content QA runs before
          anything ships.
        </p>
      </li>
      <li class="card reveal" style="--reveal-delay:160ms">
        <p><strong>No ads, no account, no API keys.</strong></p>
        <p class="meta-line">
          Grading runs in your browser and progress stays on your device — see
          <a href="/about">how it works</a>.
        </p>
      </li>
    </ul>
  </section>
</BaseLayout>
